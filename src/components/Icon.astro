---
import { ICONS } from "../lib/icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: number;
}

const { name, size = 18, class: cls = "", stroke = 1.6 } = Astro.props;
const body = ICONS[name] ?? "";
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={body}
/>
