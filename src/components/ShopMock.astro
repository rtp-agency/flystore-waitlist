---
/**
 * Макет витрины для галереи примеров.
 *
 * Раскладка зависит от скелета, а не только палитра: каталог, одностраничник,
 * распродажа и мгновенная выдача это четыре разные страницы. Четыре одинаковые
 * карточки в разных цветах доказывали бы ровно обратное тому, что написано
 * над ними.
 */
import Icon from "./Icon.astro";

interface Props {
  shop: any;
}

const { shop } = Astro.props;
const L = shop.look;
---

<div class="flex h-[20.5rem] flex-col p-4" style={`background:${L.bg}`}>
  <!-- Шапка витрины общая: название и меню есть у любого магазина. -->
  <div class="flex shrink-0 items-center justify-between">
    <span class="font-display text-[0.9rem] font-bold" style={`color:${L.ink}`}>{shop.name}</span>
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-1 w-6 rounded-full opacity-40" style={`background:${L.muted}`}></span>
      <span class="h-1 w-4 rounded-full opacity-40" style={`background:${L.muted}`}></span>
    </span>
  </div>

  {
    shop.kind === "catalog" && (
      <>
        <div
          class="relative mt-3 h-28 shrink-0 overflow-hidden p-3.5"
          style={`background:${L.band};border-radius:${L.radius}`}
        >
          <span class={`absolute bottom-9 left-3.5 text-white ${shop.headlineClass}`}>
            {shop.headline}
          </span>
          <span
            class="absolute bottom-3.5 left-3.5 bg-white/90 px-2.5 py-1 text-[0.6rem] font-medium text-ink"
            style={`border-radius:${L.radius}`}
          >
            Смотреть
          </span>
        </div>

        <div class="mt-3 grid grid-cols-3 gap-2.5">
          {shop.goods.map((item: any) => (
            <div class="space-y-1.5">
              <div
                class="aspect-square"
                style={`background:${item.tone};border-radius:${L.radius}`}
              />
              <p class="text-[0.62rem] leading-none" style={`color:${L.ink}`}>
                {item.name}
              </p>
              <p
                class="font-mono text-[0.58rem] leading-none tabular-nums"
                style={`color:${L.muted}`}
              >
                {item.price}
              </p>
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    shop.kind === "lookbook" && (
      <>
        {/* Витрина-журнал: одно крупное фото и два сбоку, подписи под ними. */}
        <div class="mt-3 grid h-40 shrink-0 grid-cols-[1.5fr_1fr] gap-2">
          <div
            class="relative overflow-hidden p-3"
            style={`background:${L.band};border-radius:${L.radius}`}
          >
            <span class={`absolute bottom-3 left-3 text-white ${shop.headlineClass}`}>
              {shop.headline}
            </span>
          </div>
          <div class="grid grid-rows-2 gap-2">
            {shop.goods.slice(0, 2).map((item: any) => (
              <div style={`background:${item.tone};border-radius:${L.radius}`} />
            ))}
          </div>
        </div>

        <div class="mt-3.5 space-y-2">
          {shop.goods.map((item: any) => (
            <div class="flex items-baseline justify-between">
              <span class="text-[0.66rem]" style={`color:${L.ink}`}>
                {item.name}
              </span>
              <span
                class="font-mono text-[0.6rem] tabular-nums"
                style={`color:${L.muted}`}
              >
                {item.price}
              </span>
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    shop.kind === "loud" && (
      <>
        {/* Распродажа: заголовок вместо фотографии и плотная сетка. */}
        <div
          class="relative mt-3 shrink-0 overflow-hidden px-3.5 py-4"
          style={`background:${L.band};border-radius:${L.radius}`}
        >
          <span class={`block text-white ${shop.headlineClass}`}>{shop.headline}</span>
          <span class="mt-1 block font-mono text-[0.58rem] tracking-wide text-white/80">
            {shop.note}
          </span>
        </div>

        <div class="mt-2.5 grid grid-cols-2 gap-2">
          {shop.goods.map((item: any) => (
            <div
              class="flex items-center gap-2 p-2"
              style={`background:${item.tone};border-radius:${L.radius}`}
            >
              <span
                class="h-7 w-7 shrink-0"
                style={`background:${L.muted}55;border-radius:${L.radius}`}
              />
              <span class="min-w-0">
                <span class="block truncate text-[0.6rem]" style={`color:${L.ink}`}>
                  {item.name}
                </span>
                <span
                  class="block font-mono text-[0.56rem] tabular-nums"
                  style={`color:${L.muted}`}
                >
                  {item.price}
                </span>
              </span>
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    shop.kind === "instant" && (
      <>
        {/* Мгновенная выдача: товар это строка, а не фотография. */}
        <p class={`mt-3 ${shop.headlineClass}`} style={`color:${L.ink}`}>
          {shop.headline}
        </p>
        <p class="mt-1.5 text-[0.62rem]" style={`color:${L.muted}`}>
          {shop.note}
        </p>

        <div class="mt-3 space-y-1.5">
          {shop.goods.map((item: any) => (
            <div
              class="flex items-center gap-2.5 px-2.5 py-2"
              style={`background:${item.tone};border-radius:${L.radius}`}
            >
              <span style={`color:${L.muted}`}>
                <Icon name="lock" size={13} />
              </span>
              <span class="min-w-0 flex-1 truncate text-[0.62rem]" style={`color:${L.ink}`}>
                {item.name}
              </span>
              <span class="font-mono text-[0.58rem] tabular-nums" style={`color:${L.ink}`}>
                {item.price}
              </span>
            </div>
          ))}
        </div>

        <div
          class="mt-3 py-2 text-center text-[0.62rem] font-medium"
          style={`background:${L.band};color:#fff;border-radius:${L.radius}`}
        >
          Получить доступ
        </div>
      </>
    )
  }

  {
    shop.kind === "single" && (
      <>
        {/* Одностраничник: один товар, цена и кнопка сразу под фотографией. */}
        <div
          class="mt-3 h-32 shrink-0"
          style={`background:${L.band};border-radius:${L.radius}`}
        />
        <p class={`mt-3 ${shop.headlineClass}`} style={`color:${L.ink}`}>{shop.headline}</p>
        <p class="mt-1 text-[0.62rem] leading-snug" style={`color:${L.muted}`}>{shop.note}</p>

        <div class="mt-3 flex items-center gap-2">
          <span class="font-display text-[1.05rem] font-bold tabular-nums" style={`color:${L.ink}`}>
            {shop.goods[0].price}
          </span>
          <span
            class="ml-auto px-3 py-1.5 text-[0.62rem] font-medium"
            style={`background:${L.band};color:#fff;border-radius:${L.radius}`}
          >
            Заказать
          </span>
        </div>
      </>
    )
  }

  <div
    class="mt-auto flex items-center justify-between border-t pt-2.5 font-mono text-[0.55rem]"
    style={`color:${L.muted};border-color:${L.muted}33`}
  >
    <span>{shop.footer?.[0] ?? "Корзина · 0"}</span>
    <span>{shop.footer?.[1] ?? "Оплата при получении"}</span>
  </div>
</div>
