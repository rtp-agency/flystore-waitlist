# Токен бота от @BotFather. Живёт только на сервере: с токеном в браузере
# чужой человек читает нашу переписку и пишет от имени бота.
TELEGRAM_BOT_TOKEN=

# Куда падают заявки. Числовые id через запятую, свой можно спросить
# у @userinfobot, id группы приходит с минусом.
# Важно: бот должен уметь вам написать. Для личного чата это значит, что вы
# один раз нажали в нём «Старт», иначе Telegram молча откажет в доставке.
TELEGRAM_CHAT_IDS=

# С каких адресов принимаем форму. Пусто значит с любых: так проще поднять
# на новом домене, но чужой сайт сможет слать заявки нам в чат.
# Полный адрес со схемой: https://flystore.app
ALLOWED_ORIGIN=

# Ссылка на наш телеграм. Читается на сборке, попадает в html.
# Пусто значит на странице ссылки не будет.
PUBLIC_TG_LINK=
